<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>ciba-sim</artifactId>
    <version>0.6.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ciba-sim</name>
    <description>A CIBA authentication device with no device: an OOBAuthPlugin that waits for a decision
        an operator records over HTTP, keyed by the auth_req_id. It exists so the OpenID conformance
        suite's FAPI-CIBA plan can approve and deny requests through its automated_ciba_approval_url,
        and for nothing else - it is a test double for the thing a real deployment gets from PingOne
        MFA or a bank's own app.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- The date written on every archive entry, so a rebuild of this commit is byte-identical. tools/set-version.py
             sets it with the version: HEAD's commit time for a release, 2000-01-01T00:00:00Z for a snapshot. -->
        <project.build.outputTimestamp>2000-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.6.0-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>pingfederate</groupId><artifactId>pf-protocolengine</artifactId><scope>provided</scope></dependency>
        <!-- PluginDescriptor uses commons-lang3 at construction; provided-scope transitives are not
             inherited, so it is declared here as instance-registry-datasource does. -->
        <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><scope>provided</scope></dependency>
        <!-- The platform library (plan items F-1, PR-1), for the deployment profile. Shaded and relocated below,
             as the RAR plugin does Jackson, so the copy in this jar - loose in deploy/ and merged into
             pf-runtime.war - never meets the one staged beside the servlets. -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>platform</artifactId></dependency>

        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <!-- ShadedJarCheck reads the jar the shade plugin wrote, so it runs after package; its name is
                         outside surefire's default patterns, so the test phase does not run it early. -->
                    <execution>
                        <id>shaded-jar</id>
                        <phase>verify</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes><include>**/ShadedJarCheck.java</include></includes>
                            <reportNameSuffix>shaded-jar</reportNameSuffix>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Coverage gate on the decisions: whether the simulator may run here at all (the switch, the
              deployment profile, the directory's owner and mode), what a recorded decision reads back as
              (and when it has gone stale), what the authenticator answers PingFederate for each, and what
              the endpoint will and will not record. 100% line + branch, per METHOD; configure(),
              getPluginDescriptor() and the read of this process's user are plumbing and stay out.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.cibasim.DecisionStore.lookup(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.DecisionStore.record(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.DecisionStore.txIdFor(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.SimOobAuthenticator.initiate(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.SimOobAuthenticator.check(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.SimOobAuthenticator.finished(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.CibaSimDecisionServlet.handle(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.SimulatorGate.refusal(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.SimulatorGate.enabled(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.SimulatorGate.isProduction(*</include>
                                        <include>com.pingidentity.ps.oidf.cibasim.SimulatorGate.directoryRefusal(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Rebuilt every time: shade replaces this jar with the shaded one under the same name, so a
                         second build that found it up to date would shade the shaded jar again. -->
                    <forceCreation>true</forceCreation>
                    <!-- PF discovers plugin jars in server/default/deploy by filename prefix; without
                         pf.plugins. it is ignored silently. The same jar is also merged into
                         pf-runtime.war, where the annotation scan finds the decision servlet. -->
                    <finalName>pf.plugins.ciba-sim</finalName>
                </configuration>
            </plugin>
            <!-- platform shaded in and relocated under this plugin's own package. platform-pf's classes live under
                 com.pingidentity.ps.oidf.platform.pf, inside the pattern, so they are excluded by name: they stay
                 PingFederate-side and are never bundled or renamed here. commons-logging, which platform's logger uses when it can see
                 it, is provided and stays PingFederate's. The jar replaces the plain one under the same name. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <artifactSet>
                                <includes>
                                    <include>com.pingidentity.ps.oidf:platform</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.pingidentity.ps.oidf.platform.</pattern>
                                    <shadedPattern>com.pingidentity.ps.oidf.cibasim.shaded.platform.</shadedPattern>
                                    <excludes><exclude>com.pingidentity.ps.oidf.platform.pf.**</exclude></excludes>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
