    {"name": "deny: an amount over 1000", "attributes": {"idp.payment_initiation.amount": "5000.00", "idp.payment_initiation.currency": "AUD", "idp.payment_initiation.actions": "[\"initiate\"]", "req_actions": "initiate", "UserID": "alice", "principal_source": "authenticated", "client_id": "payments-agent"}, "expect": {"decision": "DENY", "statements": []}},
