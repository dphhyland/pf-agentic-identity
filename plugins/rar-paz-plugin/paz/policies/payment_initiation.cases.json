    {"name": "deny: a word that contains initiate", "attributes": {"idp.payment_initiation.amount": "42.00", "idp.payment_initiation.currency": "AUD", "idp.payment_initiation.actions": "[\"reinitiate\"]", "req_actions": "reinitiate", "UserID": "alice", "principal_source": "authenticated", "client_id": "payments-agent"}, "expect": {"decision": "DENY", "statements": []}},
