{
  "description": "Decision tests for payment_initiation: each request is the governance-engine request the processor sends for the detail (GovernanceEngineRequestBuilder, default fields), and the answer the reference policy must give.",
  "cases": [
    {
      "name": "permit: a person initiates a payment of 42.00",
      "attributes": {"idp.payment_initiation.amount": "42.00", "idp.payment_initiation.currency": "AUD", "idp.payment_initiation.actions": "[\"initiate\"]",
                     "req_actions": "initiate", "UserID": "alice", "principal_source": "authenticated", "client_id": "payments-agent"},
      "expect": {"decision": "PERMIT", "statements": []}
    },
    {
      "name": "deny: an amount over 1000",
      "attributes": {"idp.payment_initiation.amount": "5000.00", "idp.payment_initiation.currency": "AUD", "idp.payment_initiation.actions": "[\"initiate\"]",
                     "req_actions": "initiate", "UserID": "alice", "principal_source": "authenticated", "client_id": "payments-agent"},
      "expect": {"decision": "DENY", "statements": []}
    },
    {
      "name": "deny: no person PingFederate authenticated",
      "attributes": {"idp.payment_initiation.amount": "42.00", "idp.payment_initiation.currency": "AUD", "idp.payment_initiation.actions": "[\"initiate\"]",
                     "req_actions": "initiate", "UserID": "payments-agent", "principal_source": "client", "client_id": "payments-agent"},
      "expect": {"decision": "DENY", "statements": []}
    },
    {
      "name": "narrowing: initiate and cancel is held to initiate",
      "attributes": {"idp.payment_initiation.amount": "42.00", "idp.payment_initiation.currency": "AUD", "idp.payment_initiation.actions": "[\"initiate\",\"cancel\"]",
                     "req_actions": "initiate cancel", "UserID": "alice", "principal_source": "authenticated", "client_id": "payments-agent"},
      "expect": {"decision": "PERMIT", "statements": [{"name": "actions", "payload": ["initiate"]}]}
    }
  ]
}
