{
  "description": "Decision tests for sales_agent: each request is the governance-engine request the processor sends for the detail (GovernanceEngineRequestBuilder, default fields), and the answer the reference policy must give.",
  "cases": [
    {
      "name": "permit: a person asks for a region the attestation vouches for",
      "attributes": {"idp.sales_agent.sales_regions": "[\"EMEA\"]", "req_sales_regions": "EMEA", "att_sales_regions": "EMEA APAC",
                     "UserID": "alice", "principal_source": "authenticated", "client_id": "sales-agent-client"},
      "expect": {"decision": "PERMIT", "statements": []}
    },
    {
      "name": "deny: a region the attestation does not vouch for",
      "attributes": {"idp.sales_agent.sales_regions": "[\"AMER\"]", "req_sales_regions": "AMER", "att_sales_regions": "EMEA APAC",
                     "UserID": "alice", "principal_source": "authenticated", "client_id": "sales-agent-client"},
      "expect": {"decision": "DENY", "statements": []}
    },
    {
      "name": "narrowing: a client alone asks for EMEA and APAC and is held to EMEA",
      "attributes": {"idp.sales_agent.sales_regions": "[\"EMEA\",\"APAC\"]", "req_sales_regions": "EMEA APAC", "att_sales_regions": "EMEA APAC",
                     "UserID": "sales-agent-client", "principal_source": "client", "client_id": "sales-agent-client"},
      "expect": {"decision": "PERMIT", "statements": [{"name": "sales_regions", "payload": ["EMEA"]}]}
    }
  ]
}
