<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>pf-rar-paz-plugin</artifactId>
    <!-- 0.1.0 with the rest of the reactor. Was 0.0.1-SNAPSHOT, a leftover of its standalone-repo
         life: nothing references its version, a SNAPSHOT cannot be part of a release, and the jar name
         is finalName-fixed (pf.plugins.pf-rar-paz-plugin.jar) so consumers see no change. -->
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>pf-rar-paz-plugin</name>
    <description>PingFederate AuthorizationDetailProcessor that maps RFC 9396 Rich Authorization Requests
        into a PingAuthorize governance-engine decision, bounded by the client attestation's entitlement.</description>
    <url>https://www.pingidentity.com/</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.2.0</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Provided by the PingFederate runtime -->
        <dependency>
            <groupId>pingfederate</groupId>
            <artifactId>pf-protocolengine</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.pingidentity.pingfederate</groupId>
            <artifactId>pingfederate-sdk</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- PingFederate 13.1 is jakarta.servlet; the plugin reads the request through getJakartaRequest(). -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Bundled at runtime: ship jackson jars alongside the plugin jar (PF also bundles jackson,
             but pin our own to avoid version drift). HTTP uses the JDK's java.net.http client (no dep). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Test -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The SDK's AuthorizationDetail holds a static commons-logging Log, so the class fails to
             initialise without it on the test classpath. PF supplies it at runtime. -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The SDK's PluginDescriptor calls commons-lang3 as it is built, so the tests that read the
             processor's descriptor need it on the test classpath. PF supplies it at runtime. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>pf.plugins.${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!--
                Coverage gate on the two answers this plugin gives that cannot be re-asked: whether a
                refresh request stays inside what was already granted, and whether the PDP actually said
                permit. 100% line + branch, enforced. RarContainment.isSubset once skipped the type
                comparison when either side was typeless, making a typeless detail a subset of anything
                while the token endpoint refused the same detail outright - a missed branch here is that
                class of bug, not a cosmetic gap. DecisionResponse.isPermit is the fail-closed reading of
                the verdict: every branch that could turn a non-permit into a permit is covered.

                AttestationAwareRarProcessor.settings turns a stored configuration into the plugin's
                switches, and a switch whose field is missing must read as its secure default: the
                one-argument getBooleanFieldValue read a missing "Deny unless PERMIT" as off. versionOf is
                what PF shows as the plugin's version.

                Gated per METHOD, not per class, so the rest stays honestly out of scope rather than
                behind a lowered number. The request builders, the PDP clients' transport paths and the
                processor's PF-SDK entry points (configure/validate/getUserConsentDescription) still carry
                missed branches; they are the next work queue, and each is added here only once a test
                closes it. JdkHttpTransport opens real sockets and is covered by the deployed probes.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.rar.RarContainment.isSubset(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.DecisionResponse.isPermit(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.AttestationAwareRarProcessor.settings(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.AttestationAwareRarProcessor.versionOf(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Shade jackson INTO the plugin jar (relocated) so it resolves on the
                 plugin's own classloader regardless of PF's per-deploy-jar isolation.
                 Provided-scope deps (PF SDK, servlet) are excluded automatically.
                 The shaded jar replaces the plain one, so its manifest must still carry
                 Implementation-Version: the version PF shows for the plugin is read from it
                 (AttestationAwareRarProcessor.versionOf), and without it PF shows "development". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <artifactSet>
                                <includes>
                                    <include>com.fasterxml.jackson.core:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>com.pingidentity.ps.oidf.rar.shaded.jackson</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
