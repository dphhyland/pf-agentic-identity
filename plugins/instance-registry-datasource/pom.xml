<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>instance-registry-datasource</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>instance-registry-datasource</name>
    <description>A PingFederate CustomDataSourceDriver over the agent instance registry. Lets an access
        token mapping resolve a pseudonymous instance identifier to its owner, status, device compliance
        and user-verification recency at issuance time — the point where revocation and the time-box
        actually bite.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.3.0</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>device-instance</artifactId></dependency>
        <dependency><groupId>pingfederate</groupId><artifactId>pf-protocolengine</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><scope>provided</scope></dependency>
        <!-- pingfederate-sdk's own POM declares commons-lang3 provided (PluginDescriptor uses StringUtils
             at construction time), but provided-scope transitive dependencies are never inherited - PF
             supplies it on the server classpath at runtime, so this module must declare it too to build
             and test standalone. Same local install services/gm-api/servlet already uses. -->
        <dependency><groupId>local.pingfederate</groupId><artifactId>commons-lang3</artifactId><version>3.x</version><scope>provided</scope></dependency>
        <!-- PF supplies a driver on its own classpath; bundling a second copy risks a LinkageError,
             the same trap the jose4j exclusion in assemble-pf-runtime-war.sh documents. -->
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>provided</scope></dependency>

        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
            <!--
              Coverage gate on the two fail-closed decisions this driver makes off its own bat: the
              value map an unknown instance yields, and the refusal to answer at all before PF has
              configured the driver. 100% line + branch, enforced - a missed branch in notFound() is a
              field that stops being false-by-default, and an issuance criterion reading it would pass
              on a missing value instead of refusing.

              Gated per METHOD, not per class, so the members that need a real PingFederate or a real
              Postgres stay honestly out of scope: configure() takes an SDK Configuration, registry()
              opens a PGSimpleDataSource, and getSourceDescriptor()/getAvailableFields() are SDK
              plumbing. lookup(), retrieveValues() and testConnection() are gate-worthy but not yet
              gate-clean - each still has a branch or a line no test reaches, listed in the coverage
              backlog rather than gated at a limit below 1.00. A gate that lands red is a gate someone
              disables.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.registry.InstanceLookup.notFound(*</include>
                                        <include>com.pingidentity.ps.oidf.registry.InstanceRegistryDataSource.requireLookup(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- PF discovers plugin jars by filename prefix; without pf.plugins. it is ignored
                         silently, which is one of the ways this fails with no error at all. -->
                    <finalName>pf.plugins.instance-registry-datasource</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
