<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>attestation-issuer</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>attestation-issuer</name>
    <description>Client Attestation issuer: the /federation/attestation issuance servlet (SPIFFE SVID → minted
        client attestation), attestation minter, per-client attester keys (OpenBao transit or inline JWK),
        SPIFFE SVID validation, and the attestation challenge servlet. Verification lives in client-attestation;
        this module is the issuing side.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.4.0-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>oidf-jose</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>client-attestation</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-integration</artifactId></dependency>
        <!-- Trust-chain validation for federation-backed wallet-provider trust (was only transitive). -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>openid-federation</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>openid-federation</artifactId><type>test-jar</type><scope>test</scope></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>agent-registry</artifactId></dependency>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>pingfederate</groupId><artifactId>pf-protocolengine</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId><scope>test</scope></dependency>
        <!-- PF's Client domain class uses commons-lang3 internally (13.1+); provided by PF at runtime, needed here to test client building -->
        <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>

            <!--
                Coverage gate on the issuance decisions: who is allowed to be issued an attestation,
                what is put in it, and which requests are refused before a key is ever touched. 100%
                line + branch, enforced - a missed branch here is a workload bound to the wrong client
                or a ceiling that quietly widens, not a cosmetic gap.

                Gated per METHOD, not per class, so the parts that need a live world stay honestly out
                of scope: OpenIdFederationClientResolver's fetch and cache (only its statement checks are
                gated), AttesterConfigurationServlet.deploymentEvidenceAudience reads the deployment
                environment, and the evidence validators (SpiffeSvidValidator, InstanceKeyProofValidator,
                WalletInstanceAttestationValidator) still have unexercised rejection paths. Those are the
                next tests to write, not a reason to lower this limit - every method listed here measured
                1.00 on both counters before it was added.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.AttestationIssuanceServlet.doPost(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.AttestationIssuanceServlet.parseRequest(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.AttestationIssuanceServlet.asObjectList(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.AttestationIssuanceServlet.mapEntitlementError(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.AttestationIssuanceServlet.federationWalletValidatorFromEnv(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.PfIssuanceClientResolver.resolve(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.ClientAttestationServiceMetadataServlet.metadata(*</include>
                                        <include>com.pingidentity.ps.oidf.issuer.AttestationIssuanceConfig.effectiveCeiling(*</include>
                                        <include>com.pingidentity.ps.oidf.issuer.InstanceAttestationValidators.require(*</include>
                                        <include>com.pingidentity.ps.oidf.issuer.InstanceAttestationValidators.requiresTrustBundle(*</include>
                                        <include>com.pingidentity.ps.oidf.issuer.InstanceAttestationValidators.with(*</include>
                                        <include>com.pingidentity.ps.oidf.issuer.RemoteJwksCache.get(*</include>
                                        <include>com.pingidentity.ps.oidf.issuer.EntraDirectoryAssertedContextResolver.fromJson(*</include>
                                        <!-- CAS §6.2: a federation entity's clients are believed only through a chain to a
                                             pinned anchor, an outage keeps the last answer, and revocation lands within
                                             one TTL; and the sources are consulted federation first. -->
                                        <include>com.pingidentity.ps.oidf.issuer.OpenIdFederationClientResolver.attestationClients(*</include>
                                        <include>com.pingidentity.ps.oidf.issuer.OpenIdFederationClientResolver.parse(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.AttesterResolvers.fromEnvironment(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.attestation.AttesterResolvers.federationValidator(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <!-- The floor is the whole module: it stops the total falling while the gate above holds the
                         decisions at 100%. Set just under what the tests reach, raised as they reach further, never
                         lowered to let a change through. The dashboard reads it from here. -->
                    <execution>
                        <id>coverage-floor</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>INSTRUCTION</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
