<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>pf-integration</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>pf-integration</name>
    <description>PingFederate integration glue: the FederationAttesterKeyResolver bridge (attestation trust via
        federation), the OGNL issuance-criteria hooks (ClientAttestationUtils, OIDFederationUtils.authorizeClientEntity),
        explicit registration, the PF-signed federation entity servlet + PfJwksSigningKeyProvider, and the oidf.war
        assembly. Depends on client-attestation + openid-federation + the PingFederate SDK.</description>
    <url>https://github.com/dphhyland/pf-integration</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.2.0</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>client-attestation</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>openid-federation</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>oidf-jose</artifactId></dependency>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>pingfederate</groupId><artifactId>pf-protocolengine</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId><scope>test</scope></dependency>
        <!-- PF's Client domain class uses commons-lang3 internally (13.1+); provided by PF at runtime, needed here to test client building -->
        <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <!-- deploy filename -> PF context path, so oidf.war serves at /oidf -->
        <finalName>oidf</finalName>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
            <!--
              Coverage gate on the registration and attestation-bridge decision points: who becomes a
              client, on whose trust chain, and what the bridge will authenticate. 100% line + branch,
              enforced - a missed branch here is a guard that never fired on the path that matters, not
              a cosmetic gap.

              Gated per METHOD, not per class, so the parts that need a live PingFederate or a real
              network stay honestly out of scope: the doFilter/doPost request paths, the PF admin-API
              client store, and the federation key resolvers that fetch entity statements. The list is
              deliberately only what measures clean today; the rest is a work queue, not a lowered bar.
              Never lower a limit below 1.00 to admit a method - cover it, or leave it out.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <!-- Who gets to be a client, and on whose authority. explicitRegister
                                             and requireConstrainedByPolicy are the two places a trust chain
                                             turns into a registration; isFederationRegistered is what later
                                             decides a client came from federation rather than by hand. -->
                                        <include>com.pingidentity.ps.oidf.pf.FederationRuntimeConfig.trustAnchor(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.utils.OIDFederationUtils.requireConfiguredAnchor(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.RegistrationService.explicitRegister(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.RegistrationService.requireConstrainedByPolicy(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.RegistrationService.isFederationRegistered(*</include>
                                        <!-- The explicit-registration body itself: typed as an Entity Statement
                                             (OpenID Federation 1.0 §3) and signed by its own jwks. The chain
                                             validator never sees this statement, so nothing downstream repeats it. -->
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.ExplicitRegistrationRequest.verifySelfSigned(*</include>
                                        <!-- The attestation bridge's configuration read: init decides whether
                                             this filter authenticates at all, and on which keys. -->
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.ClientAttestationAuthFilter.init(*</include>
                                        <!-- What the verifier is told to accept (audience/issuer) and whose
                                             subject the delegated act chain names. -->
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.utils.ClientAttestationUtils.defaultConfig(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.utils.ClientAttestationUtils.actingPartySub(*</include>
                                        <!-- FAPI 2.0 enforcement over PingFederate's own endpoints. checkClientAssertion
                                             and checkDpopProof are the rules. subjectOf, clientOfAccessToken and
                                             appliesTo decide WHOSE request it is and so whether the rules apply at
                                             all - get one wrong and a FAPI client is quietly treated as an ordinary
                                             one. violationIn is which parts of a request are examined (every DPoP
                                             header, and never one client_assertion out of several); doFilter is
                                             whether a refusal actually stops the request; init is who is listed. -->
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2RequestPolicy.checkClientAssertion(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2RequestPolicy.checkDpopProof(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2RequestPolicy.subjectOf(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2RequestPolicy.clientOfAccessToken(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2ProfileFilter.appliesTo(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2ProfileFilter.violationIn(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2ProfileFilter.doFilter(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi2.Fapi2ProfileFilter.init(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi1.FapiResourceServerFilter.doFilter(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi1.FapiResourceServerFilter.interactionIdFor(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.fapi1.FapiResourceServerFilter.carriesTokenInQuery(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.oauth.OAuthErrorDescriptionFilter.doFilter(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.oauth.OAuthErrorDescriptionFilter.sanitise(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.oauth.OAuthErrorDescriptionFilter.withinSet(*</include>
                                        <!-- The admin read surface: what it will disclose, and to whom. -->
                                        <include>com.pingidentity.ps.oidf.servlet.clientregistration.RegisteredClientsServlet.doGet(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- oidf.war is assembled by the servlets/oidf-war aggregation module (it can depend on every
                 servlet module without a reactor cycle); this module produces just its library jar. -->
        </plugins>
    </build>
    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>
</project>
