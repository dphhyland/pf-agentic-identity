{
  "format": 1,
  "component": "fapi2-profile",
  "module": "servlets/pf-integration",
  "package": "com.pingidentity.ps.oidf.servlet.fapi2",
  "families": ["OIDF_FAPI2_"],
  "settings": [
    {
      "name": "OIDF_FAPI2_CLIENTS",
      "kind": "env",
      "type": "words",
      "default": null,
      "description": "The clients the FAPI 2.0 filter holds to issuer-only assertion audiences and PS256, ES256 or EdDSA DPoP proofs, comma-separated; * is every client",
      "when_wrong": {"effect": "not-checked", "detail": "An id that names no client holds nobody"},
      "profile": "any",
      "security": true,
      "sources": [
        {"from": "init-param", "name": "clients"},
        {"from": "system-property", "name": "oidf.fapi2.clients"},
        {"from": "env", "name": "OIDF_FAPI2_CLIENTS"}
      ],
      "aliases": [],
      "file": false
    }
  ],
  "removed": []
}
