<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>oidf-war</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>oidf-war</name>
    <description>Assembles the deployable oidf.war = the aggregate of the OIDF servlet modules
        (pf-integration: federation entity + §12 registration + OGNL hooks; attestation-issuer: the
        /federation/attestation issuance servlet + challenge servlet), with their libraries bundled into
        WEB-INF/lib. web.xml is metadata-complete=false so PingFederate scans the jars for @WebServlet
        endpoints. This is where the war lives so it can depend on every servlet module without a reactor
        cycle (attestation-issuer depends on pf-integration).</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- the servlet modules whose @WebServlet endpoints make up oidf.war -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-integration</artifactId><version>0.1.0</version></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>attestation-issuer</artifactId><version>0.1.0</version></dependency>
        <!-- their runtime libraries (bundled into WEB-INF/lib); the PF SDK + servlet API stay provided -->
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId><version>0.9.6</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.17.1</version></dependency>
        <dependency><groupId>javax.servlet</groupId><artifactId>javax.servlet-api</artifactId><version>4.0.0</version><scope>provided</scope></dependency>
        <dependency><groupId>pingfederate</groupId><artifactId>pf-protocolengine</artifactId><version>13.0.0.3</version><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><version>13.0.0.3</version><scope>provided</scope></dependency>
    </dependencies>

    <build>
        <finalName>oidf</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors><descriptor>src/assembly/war.xml</descriptor></descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>make-oidf-war</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
