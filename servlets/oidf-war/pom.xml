<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>oidf-war</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>oidf-war</name>
    <description>Assembles the deployable oidf.war = the aggregate of the OIDF servlet modules
        (pf-integration: federation entity + §12 registration + OGNL hooks; attestation-issuer: the
        /federation/attestation issuance servlet + challenge servlet), with their libraries bundled into
        WEB-INF/lib. web.xml is metadata-complete=false so PingFederate scans the jars for @WebServlet
        endpoints. This is where the war lives so it can depend on every servlet module without a reactor
        cycle (attestation-issuer depends on pf-integration).</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.1.0</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- the servlet modules whose @WebServlet endpoints make up oidf.war -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-integration</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>attestation-issuer</artifactId></dependency>
        <!-- jackson is bundled into WEB-INF/lib (no separate copy on PF's shared classpath). jose4j
             stays PROVIDED: every deployment of this war also drops jose4j-0.9.6.jar directly onto
             PF's shared classpath (see build/pingfederate/Dockerfile), and bundling it a second
             time here caused a `LinkageError: loader constraint violation` on org.jose4j.jwk.JsonWebKey
             the moment a servlet touching jose4j types crossed the war's own classloader boundary
             (found via OpenIdFederationServlet, which the old static-mock-attester path never
             exercised) — two classloaders defining the "same" class are NOT the same class to the JVM. -->
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>javax.servlet</groupId><artifactId>javax.servlet-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>pingfederate</groupId><artifactId>pf-protocolengine</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><scope>provided</scope></dependency>
    </dependencies>

    <build>
        <finalName>oidf</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors><descriptor>src/assembly/war.xml</descriptor></descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>make-oidf-war</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
