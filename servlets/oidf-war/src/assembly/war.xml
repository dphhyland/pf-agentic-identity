<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>webapp</id>
    <formats><format>war</format></formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <!-- WEB-INF/web.xml (metadata-complete=false → the container scans WEB-INF/lib for @WebServlet) -->
        <fileSet>
            <directory>${project.basedir}/src/main/webapp</directory>
            <outputDirectory>.</outputDirectory>
        </fileSet>
    </fileSets>
    <dependencySets>
        <!-- every servlet module + its libraries as WEB-INF/lib jars; provided (PF SDK/servlet API/logging) excluded -->
        <dependencySet>
            <outputDirectory>WEB-INF/lib</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
            <excludes>
                <exclude>commons-logging:commons-logging</exclude>
                <exclude>org.slf4j:slf4j-api</exclude>
                <!-- Every deployment of this war also drops jose4j-0.9.6.jar directly onto PF's
                     shared classpath (deploy/pingfederate/Dockerfile). Bundling a second copy here
                     (it's a transitive compile-scope dep of pf-integration/attestation-issuer/etc,
                     so marking it `provided` on oidf-war's own direct dependency alone doesn't
                     suppress it) causes `LinkageError: loader constraint violation` on
                     org.jose4j.jwk.JsonWebKey the moment a servlet crosses the war's classloader
                     boundary using a jose4j type also visible on the shared classpath. -->
                <exclude>org.bitbucket.b_c:jose4j</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</assembly>
