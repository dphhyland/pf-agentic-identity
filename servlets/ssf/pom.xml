<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>ssf</artifactId>
    <version>0.1.4</version>
    <packaging>jar</packaging>

    <name>ssf</name>
    <description>Shared Signals Framework 1.0 (CAEP/RISC) transmitter + receiver for PingFederate: SET minting and
        verification, stream management + poll/push delivery, receiver actions (grant revocation via the PF access-grant
        SDK), PF security-audit log source, and JDBC / LDM / in-memory stream stores. Kafka publishing is
        reflection-based — no compile-time Kafka dependency.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.1.4</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>oidf-jose</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-integration</artifactId></dependency>
        <!-- The agent instance registry: CAEP inbound signals suspend/revoke instances there. Dependency
             direction is one-way (servlets/ssf -> libs/device-instance) — device-instance and
             services/device-enrolment never depend back on this module or its provided PF SDK jars. -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>device-instance</artifactId></dependency>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>javax.servlet</groupId><artifactId>javax.servlet-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>pingfederate</groupId><artifactId>pf-protocolengine</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                      Coverage gate on the SSF trust decisions: who may call a stream endpoint, which
                      subject an inbound signal actually names, what leaves as a signed SET, and which
                      deliveries are retried rather than dropped. 100% line + branch, enforced - a missed
                      branch here is a signal acted on for the wrong subject, or a caller let past a scope
                      check, not a cosmetic gap.

                      Gated per METHOD, not per class, so the container-bound and PF-bound members stay
                      honestly out of scope: the servlet doGet/doPost entry points, the JDBC and LDM stores,
                      and SsfSupport's bootstrap need a running PingFederate with a datasource behind it.
                      The methods listed here are the ones reachable from a plain unit test, and every one
                      of them measured clean before it was added - the gate went in green, not aspirational.

                      LogoutEventFilter.extractSubject is absent on a technicality worth knowing: its
                      one-arg overload is clean, its two-arg overload is not, and an include pattern cannot
                      tell them apart. Every other omission is a real coverage gap - a queue of tests to
                      write, not a reason to lower the limit. Add a method here only after measuring it
                      clean; a gate that lands red is a gate someone switches off.
                    -->
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <!-- Endpoint authorisation: bearer/scope admission to the stream API. -->
                                        <include>com.pingidentity.ps.oidf.servlet.ssf.SsfHttp.authorize(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.AuthContext.hasScope(*</include>

                                        <!-- Stream ownership: which receiver a stream answers to. admits() is the whole
                                             rule, requireStream() the one place every per-stream operation asks it, and
                                             listStreams() the filter - the endpoint that used to hand out every id. -->
                                        <include>com.pingidentity.ps.oidf.ssf.StreamAccess.admits(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamAccess.clientIdOf(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamManagementService.requireStream(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamManagementService.listStreams(*</include>

                                        <!-- Stream management: what a receiver is allowed to register and be sent. -->
                                        <include>com.pingidentity.ps.oidf.ssf.StreamManagementService.requireDeliverableEndpoint(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamManagementService.createStream(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamManagementService.setStatus(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamManagementService.narrowToDeliverable(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.InMemorySsfStore.addSubject(*</include>

                                        <!-- Delivery: retry/backoff, so a failed push is neither lost nor hammered; and setTtlSeconds, so an undelivered SET does not outlive it. -->
                                        <include>com.pingidentity.ps.oidf.ssf.PushDeliveryService.handleRetry(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.PushDeliveryService.backoffSeconds(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.PushDeliveryService.evictExpired(*</include>

                                        <!-- Inbound signals: which subject a received SET acts on. -->
                                        <include>com.pingidentity.ps.oidf.ssf.InstanceRegistryReceiverHandler.onSet(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.InstanceRegistryReceiverHandler.deviceIdOf(*</include>

                                        <!-- Outbound signals: which PF audit events become SETs, and their signing. -->
                                        <include>com.pingidentity.ps.oidf.ssf.AuditEventMapper.map(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.SetMinter.sign(*</include>
                                        <include>com.pingidentity.ps.oidf.servlet.ssf.SsfAuditLogSource.attachTo(*</include>

                                        <!-- SCIM subject lifecycle: which stream a subject is added to or removed from. -->
                                        <include>com.pingidentity.ps.oidf.ssf.ScimSubjectService.assign(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.ScimSubjectService.deprovision(*</include>

                                        <!-- What the transmitter will sign, and for whom. provisions() is who may have an
                                             account-disabled raised (SCIM - never a receiver); mayAddress() and
                                             resolveAudience() are which aud a receiver's SETs carry. -->
                                        <include>com.pingidentity.ps.oidf.servlet.ssf.SsfHttp.authorizeProvisioner(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamAccess.provisions(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamAccess.mayAddress(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.ScimSubjectService.requireProvisioner(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.StreamManagementService.resolveAudience(*</include>

                                        <!-- Raising an event: subscribes() is the one rule every emission path applies
                                             (membership, or default_subjects ALL); emit() is who may raise one (a provisioner);
                                             parse() is what the transmitter will sign; parseDefaultSubjects() the two spellings. -->
                                        <include>com.pingidentity.ps.oidf.ssf.SsfEventEmitter.subscribes(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.SsfEmitService.emit(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.EmitRequest.parse(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.EmitRequest.requireEventType(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.EmitRequest.stampTimestamp(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.EmitRequest.checkInitiatingEntity(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.EmitRequest.normaliseReason(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.EmitRequest.checkInteropSubject(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.EmitRequest.requireOneOf(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.SsfConfiguration.parseDefaultSubjects(*</include>

                                        <!-- Receiver fail-closed: no audience or no endpoint token, no receiver. -->
                                        <include>com.pingidentity.ps.oidf.ssf.SsfConfiguration.receiverMissingRequirements(*</include>
                                        <include>com.pingidentity.ps.oidf.ssf.SsfSupport.receiverMayRun(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
