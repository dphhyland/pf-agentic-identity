# ---- GM API extension service ----
GM_PORT=8080
LOG_LEVEL=debug

# Set to true ONLY for local demo without a real AS. Never in a deployed env.
SKIP_JWT_VALIDATION=false

# ---- PingFederate ----
# Base URL of the PF admin API host (Persistent Grant Management API)
GM_PINGFEDERATE_URL=https://pingfederate.example.com:9999
PINGFED_ADMIN_USER=administrator
PINGFED_ADMIN_PASS=
# JWKS endpoint used to validate inbound access tokens
JWKS_URL=https://pingfederate.example.com:9031/ext/jwks
# Expected "iss" claim on inbound access tokens (the AS issuer identifier).
# Leave unset to skip issuer validation — signature-only trust.
TOKEN_ISSUER=https://pingfederate.example.com:9031

# ---- AuthZEN PDP ----
# Base URL of the AuthZEN 1.0 PDP. The bundled demo PDP (cmd/pdp) serves
# /access/v1/evaluation and /access/v1/evaluations.
AUTHZEN_BASE_URL=http://localhost:9090

# How the GM API authenticates TO the PDP: bearer | oauth | none.
# 'none' sends no credentials and is only for a PDP that is genuinely unprotected,
# such as the bundled demo PDP.
AUTH_TYPE=none
# AUTH_BEARER_TOKEN=
# OAUTH_BASE_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_SCOPE=

# ---- Claim mapping ----
# Claim carrying the subject identifier presented to the PDP
SUBJECT_CLAIM_NAME=sub
# Claim matched against the grant's userKey to prove grant ownership
GRANT_USER_KEY_CLAIM=preferred_username
