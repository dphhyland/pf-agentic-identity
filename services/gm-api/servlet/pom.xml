<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The reactor's version, moved with the other poms by tools/set-version.py. The coordinates stay
         au.com.idpartners:gm-api: it joined the lockstep at 0.2.0, from a standalone 1.0.0. -->
    <groupId>au.com.idpartners</groupId>
    <artifactId>gm-api</artifactId>
    <version>0.7.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Grant Evaluation API (PingFederate servlet)</name>
    <description>The Grant Evaluation API deployed inside PingFederate. Reads grants in-process via
        AccessGrantManagerAccessor and validates tokens against PF's own signing keys, so none of the
        sidecar's seams exist: no service account, no TLS trust, no JWKS fetch.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- The war ships as a release asset, not a Maven artifact. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The date written on every archive entry, so a rebuild of this commit is byte-identical. tools/set-version.py
             sets it with the version: HEAD's commit time for a release, 2000-01-01T00:00:00Z for a snapshot. -->
        <project.build.outputTimestamp>2000-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.7.0-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- All provided by PingFederate at run time. jose4j and jackson are at the versions the BOM holds
             to the image (tools/pf-provided-versions.py); jakarta.servlet-api is the 5.0 API line the
             image's Jetty ships as 5.0.2, checked member by member by tools/pf-linkcheck.py. Bundling any of them would break linkage: PF isolates each
             deploy-dir artifact on its own classloader, so a second copy of a PF class would not be the
             same class. -->
        <dependency><groupId>com.pingidentity.pingfederate</groupId><artifactId>pingfederate-sdk</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><scope>provided</scope></dependency>
        <!-- jose4j: PF's own JWT library, and the type JwksEndpointKeyAccessor returns. Using PF's copy
             means the JsonWebKeySet we get back is the class we expect. -->
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><scope>provided</scope></dependency>
        <!-- TypeReference is jackson-core's, imported directly. -->
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><scope>provided</scope></dependency>
        <!-- platform-pf, and platform through it (plan item F-2): bundled in WEB-INF/lib, the one exception to
             "all provided". They are this repository's own jars, not PingFederate's, and this war needs its own
             copy - its own lifecycle, components and metrics - for the lifecycle listener and the health servlet
             to report this war and close only what it opened (docs/development/classloaders.md, rule 1).
             platform-pf's own PingFederate dependencies stay provided and do not come with it. -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>platform-pf</artifactId></dependency>
        <!-- No commons-lang3 or commons-logging: nothing here, main or test, reaches either (the
             local.pingfederate era declared both; the war compiles and its tests pass without them). -->

        <!-- The @Requirement annotation only: SOURCE retention, so it never reaches the war. -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <finalName>gm-api</finalName>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
                <!-- Implementation-Version in the war's manifest: McpServlet reports it as the MCP server version,
                     so the version an agent sees is the one the pom says, not a literal that stops being true. -->
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!--
              Coverage gate on the security-critical decision points: what the PDP is asked,
              which requests are refused before it is asked at all, and how the answer is read
              back. 100% line + branch, enforced — a missed branch here is a question asked on
              the wrong subject, a guard that does not fire, or a deny read as a permit, not a
              cosmetic gap.

              Gated per METHOD, not per class, so the socket-bound and servlet-plumbing members
              stay honestly out of scope: the McpServlet/GrantsServlet HTTP paths need a running
              PingFederate, and are covered by the deployed probes instead. PdpClient's constructor
              and post are gated since S5d: they run against real sockets in PdpTransportTest.

              Include patterns are jacoco's rendered METHOD names, not VM signatures: nested
              classes join with '.' (not '$'), a constructor repeats the simple class name, and
              parameters are fully-qualified type names. A pattern that matches nothing passes
              silently, so every include below was verified to bind to the method it names.
              Only the PfTokenVerifier constructor needs its parameter list spelled out — it is
              overloaded, and the String-only sibling is not covered.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <!-- What the PDP is asked, and who it is asked about. -->
                                        <include>au.com.idpartners.gm.servlet.GrantEvaluator.build(*</include>
                                        <include>au.com.idpartners.gm.servlet.GrantEvaluator.buildSearchRequest(*</include>
                                        <include>au.com.idpartners.gm.servlet.GrantEvaluator.buildDecisionRequest(*</include>
                                        <!-- The refusals that stop a request before the PDP ever sees it. -->
                                        <include>au.com.idpartners.gm.servlet.GrantEvaluator.authorise(*</include>
                                        <include>au.com.idpartners.gm.servlet.GrantView.isExpired(*</include>
                                        <!-- How the PDP's answer is turned into a permit, a deny, or a retry. -->
                                        <include>au.com.idpartners.gm.servlet.GrantOperations.evaluate(*</include>
                                        <include>au.com.idpartners.gm.servlet.GrantOperations.revoke(*</include>
                                        <include>au.com.idpartners.gm.servlet.GrantOperations.Decision.retryable(*</include>
                                        <!-- The subject the whole decision is about, parsed off the token. -->
                                        <include>au.com.idpartners.gm.servlet.TokenClaims.from(*</include>
                                        <include>au.com.idpartners.gm.servlet.PfTokenVerifier.PfTokenVerifier(com.pingidentity.access.JwksEndpointKeyAccessor*</include>
                                        <!-- The path parse that decides which grant a caller is acting on. -->
                                        <include>au.com.idpartners.gm.servlet.GrantsServlet.evaluateGrantIdFrom(*</include>
                                        <!-- The settings, strictly, and the PDP over https unless development (ST-5, PR-3). -->
                                        <include>au.com.idpartners.gm.servlet.McpServlet.ServletConfigs.from(*</include>
                                        <!-- S5d: pdpTimeoutMs (zero and below the default) and every PDP failure mapped to an unavailable PDP. -->
                                        <include>au.com.idpartners.gm.servlet.PdpClient.PdpClient(*</include>
                                        <include>au.com.idpartners.gm.servlet.PdpClient.post(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
