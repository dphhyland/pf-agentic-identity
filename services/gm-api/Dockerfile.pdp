# AuthZEN PDP
FROM golang:1.23-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/pdp ./cmd/pdp

FROM alpine:3.20
RUN apk --no-cache add ca-certificates
WORKDIR /app

COPY --from=build /out/pdp /app/pdp
# The policy is data, not code: mount or rebuild to change what the PDP decides.
COPY --from=build /src/policy /app/policy

ENV PDP_POLICY=/app/policy/openbanking.yaml
EXPOSE 9090
CMD ["/app/pdp"]
