# pingfederate-runtime config-as-code — PRODUCTION.
# Non-secret Railway service vars applied by the deploy workflow. Secrets are NEVER here — they are
# GitHub Actions secrets applied to the Railway service (see .github/workflows/deploy-pingfederate.yml).
#
# Licensing: DevOps-fetched. The image bakes no pingfederate.lic; the base image's boot hook pulls a
# fresh eval license using these vars. EULA acceptance is non-secret; the credentials are secrets:
#   PING_IDENTITY_DEVOPS_USER   <- GitHub secret PING_IDENTITY_DEVOPS_USER (a person's DevOps email)
#   PING_IDENTITY_DEVOPS_KEY    <- GitHub secret PING_IDENTITY_DEVOPS_KEY
PING_IDENTITY_ACCEPT_EULA=YES

# SSF transmitter — env-based config (SsfConfiguration reads OIDF_SSF_<NAME>, or oidf.ssf.<name> from
# run.properties, or a web.xml init-param). Setting OIDF_SSF_ISSUER turns the transmitter on at boot
# (fail-soft: unset = SSF endpoints disabled, never breaks PF). The issuer MUST equal the external base
# receivers use — it's the SET `iss` and the base of jwks_uri (<issuer>/pf/JWKS). With the reassembled war
# the module serves at ROOT, so this is just the PF external base (the runtime TCP proxy).
OIDF_SSF_ISSUER=https://reseau.proxy.rlwy.net:38844
# Optional: OIDF_SSF_RECEIVER_SCOPE (default ssf.manage), OIDF_SSF_DATA_STORE_ID (PF JDBC data store id
# for durable/cluster-safe storage), OIDF_SSF_KAFKA_ENABLED + OIDF_SSF_KAFKA_BOOTSTRAP_SERVERS.
# Receiver auth (stream mgmt/poll/SCIM) validates bearer tokens by PF introspection — set the introspection
# client as SECRETS, never here: OIDF_SSF_INTROSPECTION_CLIENT_ID + OIDF_SSF_INTROSPECTION_CLIENT_SECRET
# (GitHub Actions secrets). The logout → caep.session-revoked signal needs none of that.

# REQUIRED since the modular jars: OpenIdFederationServlet is loadOnStartup=1 and kills pf-runtime.war
# at boot without a trust anchor (the old monolith initialised lazily so the var could be absent).
# Production's trust anchor is lighthouse-prod. Set BEFORE the first production deploy from this context.
OIDF_FEDERATION_TRUST_ANCHORS=https://lighthouse-prod-production.up.railway.app
# REQUIRED for attestation validation (even in DEV mock-attester mode) — see vars.staging.env.
OIDF_FEDERATION_TRUST_CONTROLLER_HOST=https://lighthouse-prod-production.up.railway.app

# ── attest_jwt_client_auth bridge key ───────────────────────────────────────────────────────────
# PF has no native attestation-based client authentication. ClientAttestationAuthFilter translates a
# verified Client Attestation into a private_key_jwt assertion signed by this deployment-wide key,
# whose public half is added to each attestation client's JWKS at registration.
#
# The filter now REFUSES TO START without it, because the old behaviour was worse than a failed
# deploy: with no key the filter passed every request through, while registration created those
# clients as PUBLIC (ClientAuthenticationType.NONE) - so attestation clients were authenticated by
# nothing at all. Registration now also refuses to create an attestation client without it.
#
# No environment has ever had a bridge key, so this is set false to keep deploys working while the
# state is what it is. It makes the current posture explicit instead of silently true:
# attestation-based client authentication is INERT in this environment.
#
# To turn it on: generate an EC P-256 private JWK, set OIDF_BRIDGE_PRIVATE_JWK as a SEALED Railway
# variable (never here - this file is versioned), delete the line below, and redeploy. Rotate with
# OIDF_BRIDGE_PREVIOUS_PUBLIC_JWK set to the outgoing public half during the overlap.
OIDF_ATTESTATION_REQUIRE_BRIDGE_KEY=false
