# device-enrolment config-as-code — STAGING.
#
# IDM_DATABASE_URL and ENROLMENT_SIGNING_JWK are secrets and are NOT set here; provision them on the
# service.
#
# IDM_DATABASE_URL is the Identity Object Model directory — the SAME database the SCIM users and
# consents live in (Railway project ac9af096, service Postgres-d8lj), so an agent instance is an entry
# beside its owner. Set it from that service's reference variable, NOT from a Postgres of this
# service's own; a private database would resolve every lookup to "unknown instance". It must have the
# model repo's 006-add-agent-instance-registry migration applied.
#
# NOTE: *.railway.internal only resolves inside its own project and environment, so this service must
# be deployed into project ac9af096 to use the private hostname. From anywhere else, use that
# database's public TCP proxy instead.
#
# The PingFederate datasource plugin (plugins/instance-registry-datasource) must point at this same
# directory, or PF will refuse tokens for instances that exist.
ENROLMENT_ISSUER=https://device-enrolment-staging.up.railway.app
APPLE_TEAM_ID=JH6RX4DRG2
APPLE_BUNDLE_ID=com.idpartners.bankapprover

# Development App Attest is accepted in staging because the Apple account is development-only.
# Every enrolment made this way is flagged in the registry (device.appattest_environment) so it can
# never later be mistaken for a production binding. This MUST stay false in production.
APPLE_ALLOW_DEVELOPMENT=true

# The server-side time-box: how stale a verified user authentication may be before minting is refused.
UV_MAX_AGE_SECONDS=300

# Fails closed on a device whose compliance has never been assessed. Left true even in staging —
# turning it off here would mean the demo never exercises the check that matters.
REQUIRE_COMPLIANT_DEVICE=true

# PingOne — environment fe8ab8dc-0dbb-4da4-8ee5-004cb3a6f21d ("P1AS", region AP).
# The app is "Device Agent Enrolment" (fad0652e), a public NATIVE_APP with PKCE S256 required and
# redirect com.idpartners.bankapprover://enrolment/callback. Created separately from 98d2bb66 ("ID
# Partners Bank Approver") so it can carry the passkey policy without changing that app's
# Autonomous_MFA_Push assignment and breaking the autonomous/CIBA demo.
#
# It deliberately has no mobile.bundleId: PingOne enforces that field unique per environment, and it
# only drives PingOne's own MFA push/integrity SDK. Passkeys key off the FIDO2 relyingPartyId and
# Apple's AASA App ID, neither of which involves it.
PINGONE_ISSUER=https://auth.pingone.asia/fe8ab8dc-0dbb-4da4-8ee5-004cb3a6f21d/as
PINGONE_CLIENT_ID=fad0652e-61bd-4531-ba1a-ff7074f1939b

# Sign-on policy names whose acr genuinely means AAL2. PingOne puts the applied policy name in acr and
# this environment advertises no acr_values_supported, so it cannot be discovered — it has to be stated.
# Anything not listed here is treated as AAL1 and refused for binding.
# Bank_Signup_Passkey (c8517c22) is assigned to this app at priority 1. Inspected: despite its
# "Registration plus passkey" description it is a single MULTI_FACTOR_AUTHENTICATION action with
# fido2 enabled and SMS, voice, email, OTP and security keys all disabled — so it authenticates with
# a passkey and is usable for both enrolment and the recurring time-box refresh.
#
# Caveat worth knowing: it sets noDevicesMode BLOCK. A user with no registered passkey is blocked
# rather than invited to enrol, so a first-ever enrolment needs the passkey to already exist.
PINGONE_ACR_AAL2=Bank_Signup_Passkey

# The passkey RP is northwind-app-staging.up.railway.app, whose AASA already serves
#   {"webcredentials":{"apps":["JH6RX4DRG2.com.idpartners.bankapprover"]}}
# so the FIDO2 "Passkeys" policy (userVerification REQUIRED, enforced during authentication) needs
# no change. Note its relyingPartyId is that host, so the iOS app must use the same RP ID.
