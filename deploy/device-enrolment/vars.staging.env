# device-enrolment config-as-code — STAGING.
#
# DATABASE_URL and ENROLMENT_SIGNING_JWK are secrets and are NOT set here; provision them on the
# service. DATABASE_URL comes from the Railway Postgres plugin's reference variable.
ENROLMENT_ISSUER=https://device-enrolment-staging.up.railway.app
APPLE_TEAM_ID=JH6RX4DRG2
APPLE_BUNDLE_ID=com.idpartners.bankapprover

# Development App Attest is accepted in staging because the Apple account is development-only.
# Every enrolment made this way is flagged in the registry (device.appattest_environment) so it can
# never later be mistaken for a production binding. This MUST stay false in production.
APPLE_ALLOW_DEVELOPMENT=true

# The server-side time-box: how stale a verified user authentication may be before minting is refused.
UV_MAX_AGE_SECONDS=300

# Fails closed on a device whose compliance has never been assessed. Left true even in staging —
# turning it off here would mean the demo never exercises the check that matters.
REQUIRE_COMPLIANT_DEVICE=true

# PingOne — environment fe8ab8dc-0dbb-4da4-8ee5-004cb3a6f21d ("P1AS", region AP).
# The app is the existing NATIVE_APP registration, a public client with a custom-scheme redirect.
PINGONE_ISSUER=https://auth.pingone.asia/fe8ab8dc-0dbb-4da4-8ee5-004cb3a6f21d/as
PINGONE_CLIENT_ID=98d2bb66-3568-4ecd-b4cd-6ee8625b1ccc

# Sign-on policy names whose acr genuinely means AAL2. PingOne puts the applied policy name in acr and
# this environment advertises no acr_values_supported, so it cannot be discovered — it has to be stated.
# Anything not listed here is treated as AAL1 and refused for binding.
#
# NOT YET USABLE AS CONFIGURED. Application 98d2bb66 ("ID Partners Bank Approver") is assigned the
# Autonomous_MFA_Push sign-on policy (CIBA push), not a passkey policy — so its acr would be
# Autonomous_MFA_Push and every enrolment would be refused as AAL1. The passkey policy in this
# environment is Bank_Signup_Passkey (c8517c22). Either a dedicated native app assigned to that
# policy is created, or this app's assignment changes — the latter would alter the existing
# autonomous/CIBA demo, so it is not done unilaterally.
PINGONE_ACR_AAL2=Bank_Signup_Passkey

# The passkey RP is northwind-app-staging.up.railway.app, whose AASA already serves
#   {"webcredentials":{"apps":["JH6RX4DRG2.com.idpartners.bankapprover"]}}
# so the FIDO2 "Passkeys" policy (userVerification REQUIRED, enforced during authentication) needs
# no change. Note its relyingPartyId is that host, so the iOS app must use the same RP ID.
