# device-enrolment config-as-code — STAGING.
#
# DATABASE_URL and ENROLMENT_SIGNING_JWK are secrets and are NOT set here; provision them on the
# service. DATABASE_URL comes from the Railway Postgres plugin's reference variable.
ENROLMENT_ISSUER=https://device-enrolment-production.up.railway.app
APPLE_TEAM_ID=REPLACE_WITH_TEAM_ID
APPLE_BUNDLE_ID=com.example.agent

# Production accepts genuine App Attest only. A development attestation is produced against Apple's
# development service and carries materially weaker assurance; accepting one here would mean trusting
# an app build Apple never vetted.
APPLE_ALLOW_DEVELOPMENT=false

# The server-side time-box: how stale a verified user authentication may be before minting is refused.
UV_MAX_AGE_SECONDS=300

# Fails closed on a device whose compliance has never been assessed. Left true even in production —
# turning it off here would mean the demo never exercises the check that matters.
REQUIRE_COMPLIANT_DEVICE=true
