# When copying ../../gke-spiffe-demo/pf/terraform/extended-properties.tf in alongside clients.tf.example
# (per its own comment — the shared PF config isn't duplicated in this repo, each cloud's terraform
# directory gets its own copy against its own PF), add THIS one entry to that copy's `items` list. It is
# NOT yet in the GKE/AWS copies because neither of those leaves has a client that opts into
# AssertedContextResolver — the entra-directory resolver (servlets/attestation-issuer:
# EntraDirectoryAssertedContextResolver) is Azure-leaf-specific. Registering it is harmless to every other
# client (unregistered = the property is simply unusable, not defaulted-on) but it MUST be registered
# before `demo_attest_azure_gateway`'s attestation_asserted_context_resolver value will apply — PF rejects
# an extended_parameters key that isn't in this list.

# { name = "attestation_asserted_context_resolver", description = "Opts a client into a second-stage AssertedContextResolver, named by id (e.g. entra-directory)" },
