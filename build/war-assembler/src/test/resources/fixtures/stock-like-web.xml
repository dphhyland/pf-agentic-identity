<?xml version="1.0" encoding="UTF-8"?>

<!-- Written for these tests, in the shape of a PingFederate 13.1 pf-runtime.war descriptor: the jakartaee 5.0
     namespace, metadata-complete="false", request-wide filters mapped over /*, one mapped by servlet name, and
     the protocol servlet mapped by extension. Every name and class below is made up. -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         metadata-complete="false"
         version="5.0">

    <filter>
        <filter-name>requestTracing</filter-name>
        <filter-class>example.runtime.RequestTracingFilter</filter-class>
    </filter>

    <filter>
        <filter-name>responseCaching</filter-name>
        <filter-class>example.runtime.ResponseCachingFilter</filter-class>
    </filter>

    <filter>
        <filter-name>forwardAudit</filter-name>
        <filter-class>example.runtime.ForwardAuditFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>requestTracing</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>forwardAudit</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>responseCaching</filter-name>
        <servlet-name>protocol</servlet-name>
    </filter-mapping>

    <servlet>
        <servlet-name>protocol</servlet-name>
        <servlet-class>example.runtime.ProtocolServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>static</servlet-name>
        <servlet-class>example.runtime.StaticServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>protocol</servlet-name>
        <url-pattern>*.oauth2</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>protocol</servlet-name>
        <url-pattern>*.ciba</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>protocol</servlet-name>
        <url-pattern>*.openid</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>static</servlet-name>
        <url-pattern>/static/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>static</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
</web-app>
