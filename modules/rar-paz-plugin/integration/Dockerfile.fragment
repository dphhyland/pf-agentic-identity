# ── pf-rar-paz-plugin · PingFederate image integration fragment ──────────────────
# Add these lines to your PingFederate image Dockerfile. The /opt paths below are for
# the Ping-published `pingidentity/pingfederate` Alpine images; adjust for your distro.
#
# Build the jar first:  mvn -q package  →  target/pf.plugins.pf-rar-paz-plugin.jar

# 1. REQUIRED — drop the shaded plugin jar into PF's deploy dir. The filename must start
#    with `pf.plugins.` (that's how PF picks up deploy-dir plugin jars). The jar bundles
#    a *relocated* Jackson and carries its own `PF-INF/authorization-detail-processors`
#    marker, so it loads correctly under PF's per-jar classloader isolation.
COPY --chown=9031:0 pf.plugins.pf-rar-paz-plugin.jar \
     /opt/in/instance/server/default/deploy/pf.plugins.pf-rar-paz-plugin.jar

# 2. OPTIONAL — the branded, attribute-focused consent/approval template. Renders the
#    RFC 9396 authorization_details as the hero and demotes coarse scopes. Self-contained
#    (inline CSS + native submit buttons) so it works even when PF's runtime baseUrl is
#    internal and its default CSS/JS can't load.
COPY --chown=9031:0 oauth.approval.page.template.html \
     /opt/in/instance/server/default/conf/template/oauth.approval.page.template.html

# 3. REQUIRED IF the governance engine (PingAuthorize) is reached over TLS on a hostname
#    NOT in its certificate SAN (e.g. an internal service name like `pingauthorize`).
#    The plugin's JDK HttpClient enforces a TLS-1.3 in-handshake hostname check that a
#    trust-all SSLContext canNOT disable — only this JVM flag can. It MUST go into run.sh
#    (right after PF's own --add-opens line), NOT a container `ENV JAVA_OPTS` (Ping's
#    entrypoint clears that). Omit this line if your PDP cert's SAN matches the URL.
RUN sed -i '/add-opens=java.base\/java.lang=ALL-UNNAMED/a JAVA_OPTS="$JAVA_OPTS -Djdk.internal.httpclient.disableHostnameVerification=true"' \
      /opt/server/bin/run.sh \
    && grep -c disableHostnameVerification /opt/server/bin/run.sh
