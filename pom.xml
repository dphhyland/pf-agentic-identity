<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>pf-agentic-identity</artifactId>
    <version>0.7.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>pf-agentic-identity</name>
    <description>Agentic / workload identity on PingFederate — attestation-based client authentication
        (issuer + authenticator), OpenID Federation trust and §12 registration against a trust controller,
        RAR entitlements to PingAuthorize, SSF signals, and the Grant Management evaluation API — as one
        platform. Aggregator only: each module keeps its own standalone pom.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- The reactor aggregator is not a consumable artifact - nothing depends on it, and it has no
             distributionManagement. Without this, `mvn deploy` publishes every module successfully and
             then fails on the root, which is exactly how the v0.1.0 release died at its last step. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The date written on every archive entry, so a rebuild of this commit is byte-identical. tools/set-version.py
             sets it with the version: HEAD's commit time for a release, 2000-01-01T00:00:00Z for a snapshot. -->
        <project.build.outputTimestamp>2000-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <modules>
        <module>bom</module>
        <module>libs/conformance</module>
        <module>libs/platform</module>
        <module>libs/rar-model</module>
        <module>libs/oidf-jose</module>
        <module>libs/app-attest</module>
        <module>libs/testkit</module>
        <module>libs/device-instance</module>
        <module>libs/client-attestation</module>
        <module>libs/rs-validation</module>
        <module>libs/openid-federation</module>
        <module>libs/shared-signals</module>
        <module>libs/agent-registry</module>
        <module>libs/platform-pf</module>
        <module>build/war-assembler</module>
        <module>servlets/pf-integration</module>
        <module>servlets/attestation-issuer</module>
        <module>servlets/oidf-war</module>
        <module>servlets/ssf</module>
        <module>plugins/rar-paz-plugin</module>
        <module>plugins/instance-registry-datasource</module>
        <module>plugins/ciba-sim</module>
        <module>services/device-enrolment</module>
        <module>services/demo-rs</module>
        <module>services/gm-api/servlet</module>
        <module>services/harness</module>
        <module>tools/preflight</module>
    </modules>
</project>
