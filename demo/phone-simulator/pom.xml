<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>phone-simulator</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>phone-simulator</name>
    <description>Not a production artefact. Two runnable classes for demoing device-enrolment against
        a real HTTP server and real Postgres without a physical iPhone: DemoServerMain, which is
        Main.java's own wiring with one substitution (a shared synthetic App Attest trust root instead
        of Apple's — the one thing that genuinely cannot be produced without hardware), and
        PhoneSimulatorCli, which plays the phone's side of the ceremony over the wire against it.
        Neither class is referenced by the production Dockerfile.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <version.jose4j>0.9.6</version.jose4j>
        <version.jackson>2.17.1</version.jackson>
    </properties>

    <dependencies>
        <!-- Brings the real production classes this demo reuses rather than reimplements:
             EnrolmentService, EnrolmentHttpServer, PingOneIdTokenVerifier, JdbcInstanceRegistry — and,
             transitively, app-attest, oidf-jose, device-instance, jose4j, jackson, the Postgres driver. -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>device-enrolment</artifactId><version>0.1.0</version></dependency>

        <!-- The synthetic Apple-shaped chain builder. Test-jars are never transitive, so this and its
             BouncyCastle dependency (app-attest declares it test-scope only) must be stated here. -->
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>app-attest</artifactId><version>0.1.0</version><type>test-jar</type></dependency>
        <dependency><groupId>org.bouncycastle</groupId><artifactId>bcpkix-jdk18on</artifactId><version>1.78.1</version></dependency>

        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId><version>${version.jose4j}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${version.jackson}</version></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <!-- Copied rather than shaded, matching device-enrolment: the classpath stays inspectable. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
