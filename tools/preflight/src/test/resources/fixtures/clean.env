# A production env file the production profile refuses nothing in. PreflightJarCheck and build.yml's java job expect
# exit 0 from it; docs/operator/preflight.md shows its output.
OIDF_DEPLOYMENT_PROFILE=production
# Components this deployment does not run are switched off: a component switched off is never refused.
OIDF_FAPI_ENABLED=false
OIDF_SSF_ENABLED=false
OIDF_OPERATOR_API_ENABLED=false
OIDF_FETCH_ALLOW_HTTP=false
OIDF_FEDERATION_RESOLVE_DISCOVERY=known
# A risky value with its risk accepted, dated as the risk needs.
OIDF_REGISTRATION_EXPIRY_ENFORCEMENT=log
OIDF_ACCEPTED_RISKS=expiry-log-mode@2099-12-31
export OIDF_REDIS_URL='rediss://redis.example.com:6380'
JAVA_OPTS="-Xms512m -Xmx2g"
