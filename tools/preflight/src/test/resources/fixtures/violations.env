# One line of each kind the production profile refuses or warns about. PreflightJarCheck and build.yml's java job
# expect exit 1 from it; docs/operator/preflight.md shows its output line by line.
OIDF_DEPLOYMENT_PROFILE=production
# A forbidden switch.
OIDF_FETCH_ALLOW_HTTP=true
# A risky switch whose risk is not accepted.
OIDF_FEDERATION_RESOLVE_DISCOVERY=any
# A component switched on whose required settings (OIDF_OPERATOR_AUDIENCE, OIDF_OPERATOR_BASE_URL) are unset.
OIDF_OPERATOR_API_ENABLED=true
# A governed value that cannot be read.
OIDF_FEDERATION_IGNORE_SSL_ERRORS=yes
# An unknown name under a catalogue's family (OIDF_FEDERATION_TRUST_ANCHORS misspelt).
OIDF_FEDERATION_TRUST_ANCHOR=https://anchor.example.com
# A component switch that does not parse.
OIDF_SSF_ENABLED=maybe
# A forbidden setting whose only component is switched off: listed, refuses nothing.
OIDF_ATTESTATION_ISSUER_ENABLED=false
OIDF_ATTESTER_CIMD_URL=https://attester.example.com/cimd
# Two warnings: an OIDF_ name under no family, and an accepted-risks entry that names no risk.
OIDF_NOT_A_FAMILY=1
OIDF_ACCEPTED_RISKS=no-such-risk
# The JVM-wide flag, read from JAVA_OPTS: it refuses every component.
JAVA_OPTS="-Xmx1g -Djdk.internal.httpclient.disableHostnameVerification=true"
