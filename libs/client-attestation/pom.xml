<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>client-attestation</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>client-attestation</name>
    <description>AS-side OAuth Attestation-Based Client Authentication (draft-ietf-oauth-attestation-based-client-auth):
        verifier, models, DPoP proof validation, challenge/replay, RAR containment, SD-JWT attestation. Depends only on
        the oidf-jose SDK + the servlet API — no PingFederate.</description>
    <url>https://github.com/dphhyland/client-attestation</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.4.0-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>oidf-jose</artifactId></dependency>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <!-- Servlet-level test for the challenge endpoint: the rate cap must be shown firing
             through doPost, not only in the limiter it delegates to. -->
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                        Coverage gate on the decisions that decide whether a client's attestation is
                        believed: what the attestation JWT must survive to become a ClientAttestation,
                        the ceilings and single-use guarantees applied to it, and the RAR containment
                        test that decides which requested entitlements are inside the attested set.
                        100% line + branch, enforced - a missed branch here is an unattested client
                        let through or a replay accepted, not a cosmetic gap.

                        Gated per METHOD, not per class, so the members whose remaining branches are
                        genuinely untested stay honestly out of scope rather than being hidden behind
                        a class-level average. MiniRedisClient's socket paths, StaticAttesterKeyResolver's
                        file and trust-chain paths, and DpopProofValidator.normalizeHtu's URL edge cases
                        are the next work queue; adding a method here is how that work gets banked.
                    -->
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestationVerifier.verifyAttestation(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestationVerifier.enforceLifetimeCeiling(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestationVerifier.enforceNoReplay(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestation.workload(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.RarEntitlement.within(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.InMemoryAttestationChallengeService.issue(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ChallengeRateLimiter.allow(*</include>
                                        <!-- S3a/S3b: the store verdicts are tri-state, and an outage must reach the caller as
                                             STORE_UNAVAILABLE (503), never as a replay, an unknown challenge or a conflict;
                                             the binding of evidence to its first presenter; and the TLS parameters that
                                             keep the store's password off the wire until the peer is verified. -->
                                        <include>com.pingidentity.ps.oidf.clientattestation.RedisAttestationStore.record(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.RedisAttestationStore.consumeChallenge(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.RedisAttestationStore.bind(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.InMemoryAttestationReplayCache.record(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.InMemoryAttestationChallengeService.consumeChallenge(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.InMemoryEvidenceBindingStore.bind(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationReplayCache.firstSeen(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationChallengeService.consume(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestationVerifier.enforceChallenge(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.MiniRedisClient.sslParametersFor(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.MiniRedisClient.isIpLiteral(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.DeploymentProfile.isProduction(*</include>
                                        <!-- S4a: what binds a presentation to this server. The PoP's audience is the issuer
                                             alone; a combined-mode DPoP proof's htu is the configured endpoint, compared
                                             after RFC 3986 normalisation, and with none configured the proof is refused. -->
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestationVerifier.verifyPopMode(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestationVerifier.requireSoleAudience(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.ClientAttestationVerifier.verifyDpopMode(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.DpopProofValidator.requireHtu(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.DpopProofValidator.normalizeHtu(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.DpopProofValidator.normalizePercentEncoding(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.DpopProofValidator.removeDotSegments(*</include>
                                        <!-- S3a: which CA a rediss:// connection trusts, the transport rule, the redaction
                                             that keeps a Redis password out of log messages, which store each surface
                                             gets and the remembered refusal of plaintext, the holder a conflict names,
                                             and the challenge endpoint's 503. -->
                                        <include>com.pingidentity.ps.oidf.clientattestation.MiniRedisClient.sslContextFor(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.MiniRedisClient.caFileFromEnvironment(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.MiniRedisClient.transportRefusal(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.MiniRedisClient.redact(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationSupport.challengeService(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationSupport.replayCache(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationSupport.evidenceBindingStore(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationSupport.configureChallengeService(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationSupport.configureReplayCache(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationSupport.redisStore(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.AttestationSupport.redisClient(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.RedisAttestationStore.conflictWith(*</include>
                                        <include>com.pingidentity.ps.oidf.clientattestation.servlet.ClientAttestationChallengeServlet.doPost(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>
</project>
