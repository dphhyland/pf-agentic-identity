<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>device-instance</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>device-instance</name>
    <description>The agent instance registry and the device Client Attestation minter. The registry is the
        only place an opaque instance identifier resolves to a human; the minter issues attestations whose
        subject is that opaque identifier and never the user. No HTTP, no PingFederate, no servlet.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.4.0-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>oidf-jose</artifactId></dependency>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <!-- The JDBC driver is provided: the registry is written against java.sql, and the deployment
             supplies the driver. Tests need it at runtime to reach the Testcontainers Postgres. -->
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>provided</scope></dependency>

        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <!-- A real Postgres, not H2: the registry's invariants live in JSONB operators, partial unique
             indexes on expressions, ANY(text[]) and plpgsql triggers — none of which H2 has. The
             contract suite is meaningless against a database that cannot enforce the rules. -->
        <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>

            <!--
              Coverage gate on the decisions this module makes about identity: who an opaque
              instance id belongs to, what an attestation is allowed to claim, and what a CAEP
              signal is allowed to revoke. 100% line + branch, enforced — a missed branch here
              is a revocation that does not fire or a key level accepted on a caller's word,
              not a cosmetic gap.

              Gated per METHOD, not per class, so the paths that need infrastructure stay
              honestly out of scope: every IomInstanceRegistry member talks to a real Postgres
              through Testcontainers and is skipped wherever Docker is absent, and the
              InMemory registry's duplicate/unknown-id rejections and the minter's malformed-JWK
              path have no test yet. Those are named in the coverage backlog rather than
              gated at a limit nobody meets.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.device.DeviceAttestationMinter.rejectOverclaim(*</include>
                                        <include>com.pingidentity.ps.oidf.device.AgentInstance.userVerificationFreshAt(*</include>
                                        <include>com.pingidentity.ps.oidf.device.CaepSignalApplier.deviceComplianceChange(*</include>
                                        <include>com.pingidentity.ps.oidf.device.CaepSignalApplier.credentialChange(*</include>
                                        <include>com.pingidentity.ps.oidf.device.CaepSignalApplier.sessionRevokedForOwner(*</include>
                                        <include>com.pingidentity.ps.oidf.device.CaepSignalApplier.sessionRevokedForDevice(*</include>
                                        <include>com.pingidentity.ps.oidf.device.CaepSignalApplier.revokeAll(*</include>
                                        <include>com.pingidentity.ps.oidf.device.InMemoryInstanceRegistry.register(*</include>
                                        <include>com.pingidentity.ps.oidf.device.InMemoryInstanceRegistry.revoke(*</include>
                                        <include>com.pingidentity.ps.oidf.device.InMemoryInstanceRegistry.devicesOwnedBy(*</include>
                                        <include>com.pingidentity.ps.oidf.device.InMemoryInstanceRegistry.require(*</include>
                                        <include>com.pingidentity.ps.oidf.device.InstanceStatus.canObtainTokens(*</include>
                                        <include>com.pingidentity.ps.oidf.device.ComplianceState.fromCaepValue(*</include>
                                        <include>com.pingidentity.ps.oidf.device.Device.isDevelopmentEnrolment(*</include>
                                        <include>com.pingidentity.ps.oidf.device.InstanceIdentifiers.random(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
