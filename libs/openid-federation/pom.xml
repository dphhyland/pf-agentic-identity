    <artifactId>openid-federation</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>openid-federation</name>
    <description>OpenID Federation 1.0 building blocks: distributed trust-chain resolution + validation
        (TrustChainValidator, gateways, subordinate-statement cache), AS-side client authorization
        (ClientEntityAuthorizer — federation membership/policy/status + scope entitlement), and the entity/
        federation endpoint service. Depends only on the oidf-jose SDK + the servlet API — no PingFederate.</description>
    <url>https://github.com/dphhyland/openid-federation</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

