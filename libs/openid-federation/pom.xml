<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>openid-federation</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>openid-federation</name>
    <description>OpenID Federation 1.0 building blocks: distributed trust-chain resolution + validation
        (TrustChainValidator, gateways, subordinate-statement cache), AS-side client authorization
        (ClientEntityAuthorizer — federation membership/policy/status + scope entitlement), and the entity/
        federation endpoint service. Depends only on the oidf-jose SDK + the servlet API — no PingFederate.</description>
    <url>https://github.com/dphhyland/openid-federation</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.2.0</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>oidf-jose</artifactId></dependency>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><scope>provided</scope></dependency>
        <!-- JdbcHostedEntityRegistry is written against java.sql; the driver is provided by the
             deployment. Tests run the shipped migration against H2 in PostgreSQL mode, matching the
             pattern this module's own registry uses. (device-instance took a different route: its
             registry lives in the Identity Object Model and is tested against a real Postgres.) -->
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>

            <!--
              Coverage gate on the trust decisions this module makes: which staged statement a
              chain walk reuses instead of refetching, whose signature a chain entry is verified
              against, how far a fetch budget lets a walk go, how two metadata policies compose,
              and whether a hosted entity is allowed to resolve at all. 100% line + branch,
              enforced - a missed branch here is a chain accepted on the wrong key or a suspended
              entity still resolving, not a cosmetic gap.

              Gated per METHOD, not per class, so the network-bound and configuration-plumbing
              members stay honestly out of scope: the TrustChainValidator route walk and the
              HttpTrustControllerGateway fetches need a live federation to exercise their error
              paths, and FederationConfiguration/AttestationMetadataConfig read a real
              ServletConfig. Those are covered by the deployed probes instead. The exception is the
              gateway's Entity Configuration reads and its check of the trust anchor's own entity
              configuration against its pinned keys (bindTrustAnchor, authorityConfiguration): whether an
              untyped configuration is refused (OpenID Federation 1.0 §3) and whether the anchor's
              configuration verifies (§10.2, §11.3) are trust decisions, and a stub HTTP client
              exercises every branch of them.

              Nested classes are named with a DOT here, not a '$' - jacoco's check goal matches
              METHOD elements on the readable name (TrustChainValidator.FetchBudget.spend), and a
              '$' spelling silently matches nothing, which is a gate that looks green because it
              gates nothing. The list grows as tests close a method, never by lowering a limit.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.federation.MetadataPolicy.composeWith(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.TrustAnchor.parse(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.TrustAnchor.of(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.TrustAnchor.verify(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.HttpTrustControllerGateway.bindTrustAnchor(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.HttpTrustControllerGateway.authorityConfiguration(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.EntityStatementType.require(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.TrustControllerGateway.fetchEntityConfigurationOf(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.HttpTrustControllerGateway.fetchEntityConfiguration(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.HttpTrustControllerGateway.fetchEntityConfigurationOf(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.TrustChainValidator.FetchBudget.spend(*</include>
                                        <include>com.pingidentity.ps.oidf.federation.SubordinateStatementCache.PendingWrites.find(*</include>
                                        <include>com.pingidentity.ps.oidf.authority.EntityStatus.canResolve(*</include>
                                        <include>com.pingidentity.ps.oidf.authority.InMemoryHostedEntityRegistry.setStatus(*</include>
                                        <include>com.pingidentity.ps.oidf.authority.HostedEntityConfigurationBuilder.buildEntityConfiguration(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>
</project>
