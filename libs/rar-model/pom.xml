<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>rar-model</artifactId>
    <version>0.5.0</version>
    <packaging>jar</packaging>

    <name>rar-model</name>
    <description>The per-type containment model for RFC 9396 authorization_details: which fields a type
        has, how each is compared, and the three operations every enforcement point asks - is a candidate
        within a ceiling, what is granted for it, and what is within two ceilings at once. JDK only: no
        JSON library, no jose, no servlet, no PingFederate, so the RAR plugin can shade it and the
        servlets can borrow nothing from PingFederate's classpath for it.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.5.0</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <!-- One compile-scope dependency: platform, for the deployment profile (plan item PR-1), which is JDK
         only as this module is. The plugin shades and relocates both, and the servlets find platform
         staged beside them. Nothing else: the servlets take jose4j and Jackson from PingFederate; a JSON
         dependency here would be a third copy in one of them, so the module reads and writes JSON itself
         (Json.java). -->
    <dependencies>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>platform</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
            <!-- The vector file and its runner are a test-jar: the four runners the plan names (library,
                 AS, CAS, refresh) read one set of cases, so a semantics change fails in every module that
                 enforces containment rather than in the one whose tests were updated. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution><goals><goal>test-jar</goal></goals></execution>
                </executions>
            </plugin>

            <!--
              Coverage gate on the decisions: whether a detail is the shape its rule compares, whether a
              candidate is within a ceiling, what is granted for it, what is within two ceilings, which
              model a type gets, what a models document is allowed to say, how large a value may be, and
              what the reader refuses. 100% line + branch, enforced, per METHOD as the other libraries do
              it - a missed branch here is a field granted unexamined, which is the review's blocker B1. A
              whole-module floor sits under it, as openid-federation's does. Left out: the writer, the
              deep copy, the fingerprint's hash and the two catch blocks that turn an impossible checked
              exception into an IllegalStateException - none of them decides anything.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <!-- The three operations, and what they rest on. -->
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.contains(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.authorize(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.intersect(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.fullCeiling(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.containing(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.assertWithin(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.validate(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.model(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.typeOf(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.details(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.parseDetails(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.load(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.RarModels.fromEnvironment(java.util.Map*</include>
                                        <!-- A type's fields: shape, containment, inheritance, the meet. -->
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.TypeModel(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.check(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.checkValues(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.contains(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.inherit(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.meet(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.disagree(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.TypeModel.used(*</include>
                                        <!-- Each rule's three answers. -->
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.check(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.contains(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.meet(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.decimal(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.instant(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.FieldRule(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.nonEmptyList(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.comparable(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.noNulls(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.FieldRule.text(*</include>
                                        <!-- The limits, and what a models document may say. -->
                                        <include>com.pingidentity.ps.oidf.rar.model.Limits.check(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Limits.walk(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Limits.digits(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.ModelSchema.parse(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.ModelSchema.fieldRule(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.ModelSchema.onlyKeys(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.ModelSchema.object(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Rule.fromJson(*</include>
                                        <!-- What the reader refuses, and how a number is measured and converted. -->
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.parse(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.readValue(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.readObject(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.readArray(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.readString(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.readNumber(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.enter(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.hexDigit(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.wellFormed(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.skipWhitespace(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.decimal(*</include>
                                        <include>com.pingidentity.ps.oidf.rar.model.Json.exact(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>coverage-floor</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>INSTRUCTION</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.92</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
