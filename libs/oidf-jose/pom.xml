<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>oidf-jose</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>oidf-jose</name>
    <description>Shared JOSE/JWT + SD-JWT SDK: the crypto foundation the client-attestation and openid-federation
        libraries build on. No PingFederate, servlet, federation, or attestation dependencies.</description>
    <url>https://github.com/dphhyland/oidf-jose</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.2.0</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>

            <!--
              Coverage gate on the JOSE decisions a caller cannot re-check for itself: what a JWT's
              header says it is, which claims are allowed to be missing, which SD-JWT digests get
              reconstructed into a payload, and which hosts escape the outbound address rule. 100%
              line + branch, enforced - a missed branch here is a typ confusion, a required claim
              silently absent, an undisclosed digest reconstructed anyway, or a private endpoint
              waved through, not a cosmetic gap.

              Gated per METHOD, not per class, so the members that need a socket or a real key stay
              honestly out of scope: JdkHttpGetClient.get and OpenBaoTransitSigner.sign talk to a
              server, and the verifyAgainstKeys/verifyAttestationPop consumers still have
              null-argument branches no test reaches. Those are the queue, not the gate - widen the
              includes as tests land, never lower the limits.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.jose.JwtCodec.verifyAgainstInlineJwks(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.JwtCodec.parseUnverifiedClaims(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.JwtCodec.getJwtHeaders(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.JwtCodec.getType(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.JwtCodec.requireType(*</include>
                                        <!-- The only verification of a request object's signature before a client is
                                             registered from it (OpenID Federation 1.0 §12.1.1.1.2): no none, no MAC. -->
                                        <include>com.pingidentity.ps.oidf.jose.JwtCodec.verifySignature(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.Claims.requiredMap(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.Claims.requireNonBlank(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.Claims.stringList(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.SdJwt.reconstruct(*</include>
                                        <include>com.pingidentity.ps.oidf.jose.OutboundUrlPolicy.addressExempt(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Published as a versioned artifact; downstream repos (client-attestation, openid-federation) depend on it.
         Registry defaults to GitHub Packages; `mvn deploy` needs a settings.xml server 'github' with a token. -->
    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>
</project>
