<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>app-attest</artifactId>
    <version>0.1.3</version>
    <packaging>jar</packaging>

    <name>app-attest</name>
    <description>Apple App Attest verification: attestation objects and assertions from DCAppAttestService,
        validated to Apple's App Attestation Root CA. Pure verification — no HTTP, no PingFederate, no servlet.
        Attests the app and the device, never the user; the key it attests is its own, so binding an
        independently generated Secure Enclave key is the caller's job via clientDataHash.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.1.3</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- CBOR is the attestation object's wire format. Jackson's CBOR dataformat keeps us on the
             one JSON/binary stack the rest of the repo already uses. -->
        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-cbor</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <!-- jose4j only for JWK shaping of the attested key, matching PF's own JOSE library exactly. -->
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <!-- Test only: the JDK has no public API for issuing an X.509 certificate with a custom
             extension, and App Attest's whole trust story hangs on one (the nonce, OID
             1.2.840.113635.100.8.2). BouncyCastle mints a synthetic Apple-shaped chain so the
             verifier can be tested without a physical device. Never on the runtime classpath. -->
        <dependency><groupId>org.bouncycastle</groupId><artifactId>bcpkix-jdk18on</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
            <!-- The synthetic Apple-shaped chain builder is reused by device-enrolment's tests.
                 Publishing it as a test-jar beats duplicating certificate minting in two modules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution><goals><goal>test-jar</goal></goals></execution>
                </executions>
            </plugin>

            <!--
              Coverage gate on the decisions that decide whether an attestation is believed: what this
              verifier is configured to accept, which environment an aaguid names, how the packed
              authenticator-data struct is read, and the chain and key bytes the trust decision rests
              on. 100% line + branch, enforced - a missed branch here is a development attestation
              accepted in production, or a truncated struct read past its end, not a cosmetic gap.

              Gated per METHOD, not per class, so the paths still short of 100% stay honestly out of
              scope rather than dragging the limit down with them: verifyAttestation, verifyAssertion,
              nonceFromCertificate, readCbor/binary/readChain and DerReader.readValue each have failure
              branches no test drives yet - a non-EC credCert key, long-form DER lengths, an x5c entry
              that is not a certificate. Those are the queue, not a reason to weaken this rule.

              Pattern notes, all confirmed empirically against jacoco 0.8.12 rather than assumed: a
              constructor is named Class.Class(, a nested class is Outer.Inner. and not Outer$Inner.,
              and a BRANCH limit on a branch-free method (validateChain, uncompressedPoint) passes
              vacuously instead of erroring.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <!-- Policy: what this verifier will accept at all. -->
                                        <include>com.pingidentity.ps.oidf.appattest.AppAttestConfig.AppAttestConfig(*</include>
                                        <include>com.pingidentity.ps.oidf.appattest.AppAttestConfig.requireNonBlank(*</include>
                                        <include>com.pingidentity.ps.oidf.appattest.AppAttestConfig.accepts(*</include>
                                        <!-- Which environment produced an attestation: the development/production line. -->
                                        <include>com.pingidentity.ps.oidf.appattest.AppAttestEnvironment.fromAaguid(*</include>
                                        <include>com.pingidentity.ps.oidf.appattest.AuthenticatorData.environment(*</include>
                                        <!-- The packed struct every later check reads its facts out of. -->
                                        <include>com.pingidentity.ps.oidf.appattest.AuthenticatorData.parse(*</include>
                                        <!-- Chain to the pinned Apple root, and the key bytes the key id is hashed from. -->
                                        <include>com.pingidentity.ps.oidf.appattest.AppAttestVerifier.validateChain(*</include>
                                        <include>com.pingidentity.ps.oidf.appattest.AppAttestVerifier.uncompressedPoint(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>

</project>
