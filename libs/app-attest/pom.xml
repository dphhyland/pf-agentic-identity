<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>app-attest</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>app-attest</name>
    <description>Apple App Attest verification: attestation objects and assertions from DCAppAttestService,
        validated to Apple's App Attestation Root CA. Pure verification — no HTTP, no PingFederate, no servlet.
        Attests the app and the device, never the user; the key it attests is its own, so binding an
        independently generated Secure Enclave key is the caller's job via clientDataHash.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <version.jose4j>0.9.6</version.jose4j>
        <version.jackson>2.17.1</version.jackson>
        <version.commons-logging>1.2</version.commons-logging>
        <version.junit.jupiter>5.10.2</version.junit.jupiter>
        <version.bouncycastle>1.78.1</version.bouncycastle>
    </properties>

    <dependencies>
        <!-- CBOR is the attestation object's wire format. Jackson's CBOR dataformat keeps us on the
             one JSON/binary stack the rest of the repo already uses. -->
        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-cbor</artifactId><version>${version.jackson}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${version.jackson}</version></dependency>
        <!-- jose4j only for JWK shaping of the attested key, matching PF's own JOSE library exactly. -->
        <dependency><groupId>org.bitbucket.b_c</groupId><artifactId>jose4j</artifactId><version>${version.jose4j}</version></dependency>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><version>${version.commons-logging}</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${version.junit.jupiter}</version><scope>test</scope></dependency>
        <!-- Test only: the JDK has no public API for issuing an X.509 certificate with a custom
             extension, and App Attest's whole trust story hangs on one (the nonce, OID
             1.2.840.113635.100.8.2). BouncyCastle mints a synthetic Apple-shaped chain so the
             verifier can be tested without a physical device. Never on the runtime classpath. -->
        <dependency><groupId>org.bouncycastle</groupId><artifactId>bcpkix-jdk18on</artifactId><version>${version.bouncycastle}</version><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
            <!-- The synthetic Apple-shaped chain builder is reused by device-enrolment's tests.
                 Publishing it as a test-jar beats duplicating certificate minting in two modules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution><goals><goal>test-jar</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
