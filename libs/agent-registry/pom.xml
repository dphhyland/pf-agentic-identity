<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pingidentity.ps.oidf</groupId>
    <artifactId>agent-registry</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>agent-registry</name>
    <description>Mints and resolves agent_id: a random-not-derived, per-running-instance identifier,
        keyed by the natural key (iss, client_id, instance_format, instance_subject). A sibling of, and
        deliberately not coupled to, the (not-yet-merged) device-instance module's own enrolment-time
        instance registry — that module pre-registers an instance at enrolment and already has a stable
        id to rename into agent_id (Phase 2.5); this module is for runtimes that have no enrolment step
        of their own (e.g. a SPIFFE workload) and need an id lazily minted, then kept stable, on first
        attestation. No PingFederate types.</description>
    <url>https://github.com/dphhyland/pf-agentic-identity</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- Shared dependency versions come from the repo BOM (bom/pom.xml). This pom stays standalone
         otherwise: no parent, plugin config kept local. -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>pf-agentic-identity-bom</artifactId><version>0.4.0-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId></dependency>
        <!-- JdbcAgentRegistry is written against java.sql; the driver is provided by the deployment.
             Tests run the shipped migration against H2 in PostgreSQL mode. -->
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>com.pingidentity.ps.oidf</groupId><artifactId>conformance</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>

            <!--
              Coverage gate on agent_id's decision points: what is admitted as a natural key, and
              which registry a process ends up sharing. 100% line + branch, enforced — a missed
              branch here is a blank field accepted into a natural key (two different instances
              collapsing onto one agent_id), or a caller getting a registry it never opted into.

              Gated per METHOD, not per class, so the store-bound members stay honestly out of
              scope: JdbcAgentRegistry.resolveOrMint's vanished-row and SQLException arms need a
              store that deletes or fails underneath the upsert, and configureJdbcRegistry needs a
              second-configuration race against a real DataSource. Those are the next work queue,
              not a reason to weaken the limit here.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>METHOD</element>
                                    <includes>
                                        <include>com.pingidentity.ps.oidf.agent.AgentIdMinter.mint(*</include>
                                        <include>com.pingidentity.ps.oidf.agent.AgentRegistrySupport.configureInMemoryRegistry(*</include>
                                        <include>com.pingidentity.ps.oidf.agent.AgentRegistrySupport.registry(*</include>
                                        <include>com.pingidentity.ps.oidf.agent.InMemoryAgentRegistry.resolveOrMint(*</include>
                                        <include>com.pingidentity.ps.oidf.agent.InMemoryAgentRegistry.NaturalKey.validated(*</include>
                                        <include>com.pingidentity.ps.oidf.agent.InMemoryAgentRegistry.NaturalKey.requireNonBlank(*</include>
                                        <include>com.pingidentity.ps.oidf.agent.JdbcAgentRegistry.requireNonBlank(*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- Published to the monorepo's own package registry. These used to point at the abandoned
         standalone repos (dphhyland/oidf-jose, /client-attestation, /pf-integration) that this repo
         absorbed - so `mvn deploy` would have pushed artifacts to three repositories that are
         backport-only, and skipped every module that had no block at all. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/dphhyland/pf-agentic-identity</url>
        </repository>
    </distributionManagement>
</project>
