# The federation profile (PF_PROFILE=federation ./up.sh): PingFederate as its own Trust Anchor, for the
# conformance suite's OpenID Federation plans. up.sh appends it to vars.env and substitutes the issuer
# on its OIDF_FEDERATION_* lines, as it does on vars.env's own.
#
# vars.env switches federation and automatic registration off - the FAPI, SSF and CIBA plans want them
# out of the way. This switches both back on (these lines come after vars.env's, and docker compose keeps
# the last value of a name) and names PF as its own anchor and controller, so its entity configuration
# says it is a Trust Anchor and publishes fetch, list and resolve. Attestation stays off. The anchor's keys
# are PF's own, read from its signing key store whenever a chain is checked, so nothing is pinned before
# PF has booted and a key rotation needs no change: the resolve endpoint answers for PF, and the
# registration filters validate chains that end at it.
OIDF_FEDERATION_ENABLED=true
OIDF_AUTO_REGISTRATION_ENABLED=true
OIDF_FEDERATION_TRUST_ANCHORS=https://localhost:9031
OIDF_FEDERATION_TRUST_CONTROLLER_HOST=https://localhost:9031
OIDF_FEDERATION_SELF_ANCHOR=https://localhost:9031
OIDF_FEDERATION_ORGANIZATION_NAME=pf-agentic-identity conformance rig
