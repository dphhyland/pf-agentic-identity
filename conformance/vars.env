# The running PingFederate's NON-secret environment. up.sh renders it into .context/vars.env with
# the issuer substituted (PF_BASE_URL) and the one generated secret appended; docker-compose.yml
# reads that. A deployment applies the same values as service variables. Secrets - the DevOps
# licence credentials and OIDF_SSF_INTROSPECTION_CLIENT_SECRET - are never in this file.

PING_IDENTITY_ACCEPT_EULA=YES

# ── Shared Signals transmitter ──────────────────────────────────────────────────────────────────
# The SET `iss`, the base of every endpoint in /.well-known/ssf-configuration, and what the suite's
# `ssf.transmitter.issuer` is compared with - so it is the same origin as terraform's pf_base_url.
OIDF_SSF_ISSUER=https://localhost:9031
# The servlet validates a receiver's token by asking PF (RFC 7662). The default endpoint is
# <issuer>/as/introspect.oauth2, which would mean PF calling itself out through whatever fronts it and
# being handed its own self-signed certificate. Loopback instead; "insecure" then means trusting that
# certificate on loopback, inside the container. This is the container's own 9031 whatever the issuer
# or the host port is - up.sh substitutes the issuer into the OIDF_SSF_ISSUER and OIDF_FEDERATION_*
# lines only, never here. It says localhost and not 127.0.0.1 because the JDK client still checks the
# certificate's name even when told to trust it, and PF's self-signed certificate names localhost.
OIDF_SSF_INTROSPECTION_ENDPOINT=https://localhost:9031/as/introspect.oauth2
OIDF_SSF_INTROSPECTION_INSECURE_TLS=true
OIDF_SSF_INTROSPECTION_CLIENT_ID=conformance-ssf-rs
# The CAEP Interop Profile's model of a stream (§2.4.4): every subject is in it without an add-subject.
# SSF calls that default_subjects ALL; the servlet advertises it and fans every event out to every
# enabled stream that delivers its type. The default plan passes either way - it only ever adds a
# subject and checks the answer - so this is set for the CAEP plan and costs the other nothing.
OIDF_SSF_DEFAULT_SUBJECTS=ALL
# The scope that lets suite/trigger-caep-events.py raise the three CAEP events the interop plan waits
# for (POST /ssf/events:emit). Held by conformance-ssf-emitter alone; a receiver's token is refused.
OIDF_SSF_PROVISIONER_SCOPE=ssf.provision

# ── Federation and attestation: present, inert, closed ──────────────────────────────────────────
# The rig runs the whole module set because that is the thing being certified, not a PF with the
# modules taken out. But it belongs to no federation, and getting "inert" right takes both of these:
#
#   OIDF_FEDERATION_TRUST_ANCHORS          OpenIdFederationServlet is loadOnStartup and takes
#                                          pf-runtime.war down unless one anchor is named.
#   OIDF_FEDERATION_TRUST_CONTROLLER_HOST  TokenEndpointAutoRegistrationFilter does the same with NO
#                                          controller at all - it calls that a deployment error and
#                                          refuses to start. (Found by booting it: 503 on everything.)
#
# So the rig names itself as both, and leaves OIDF_FEDERATION_TRUST_ANCHOR_JWKS unset. A controller
# with no pinned keys is the state the filter is written to survive: it logs the refusal at startup,
# validates no trust chain, registers nobody, and passes every token request through to PF's own
# client authentication - which is what is under test.
OIDF_FEDERATION_TRUST_ANCHORS=https://localhost:9031
OIDF_FEDERATION_TRUST_CONTROLLER_HOST=https://localhost:9031
# No bridge key here either, so attest_jwt_client_auth is off; this lets the filter start and pass
# every request through to PF's own client authentication, which is what is under test.
OIDF_ATTESTATION_REQUIRE_BRIDGE_KEY=false

# ── FAPI 2.0: the two rules PingFederate 13.0 has no setting for ────────────────────────────────
# A client assertion's aud must be the issuer, as a string; a DPoP proof must be PS256, ES256 or
# EdDSA. PF 13.0.3 accepts the token endpoint URL as an audience and RS256 on a proof, which is four
# failed modules in the suite's FAPI 2.0 plan. pf-agentic-identity's Fapi2ProfileFilter enforces both,
# for the clients listed here and for nobody else.
#
# A LIST, and not "*", because this rig is the proof of why: the suite's Shared Signals client is an
# ordinary OAuth client that addresses its assertion to the token endpoint, as OIDC Core says to. With
# the rules applied to every client, the SSF plan went from 19 of 19 to 1 of 19.
# (PF 13.1 can do the first rule natively, but the modules do not load on 13.1 - it is jakarta.servlet.)
OIDF_FAPI2_CLIENTS=conformance-fapi2-client1,conformance-fapi2-client2

# ── CIBA simulator ──────────────────────────────────────────────────────────────────────────────
# POST /ciba-sim/decision records allow or deny for an auth_req_id; the ciba-sim OOB authenticator
# answers PingFederate with it. It is an approval oracle keyed by nothing but the auth_req_id, off
# unless this says otherwise, and on here because this is a conformance rig: the suite is the only
# party holding an auth_req_id. The directory is where the servlet (in the war) and the plugin (a
# loose jar) meet - two classloaders, one filesystem.
OIDF_CIBA_SIM_ENABLED=true
OIDF_CIBA_SIM_DIR=/opt/out/instance/server/default/data/ciba-sim
