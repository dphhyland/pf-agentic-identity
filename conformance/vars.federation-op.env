# The OpenID Federation OP plan (PF_PROFILE=federation-op ./up.sh): what the federation profile sets, and PF
# joined to the conformance suite's own federation. For each plan run the suite hosts a trust anchor at
# <suite>/test/a/<alias>/trust-anchor and a relying party beneath it, which registers at PF's authorization
# and PAR endpoints (OpenID Federation 1.0 §12.1). up.sh fills in the suite's origin (SUITE_BASE_URL), the
# alias (SUITE_ALIAS, the one in suite/federation-op.template.json) and the anchor's public keys.
OIDF_FEDERATION_TRUST_ANCHOR_JWKS={"{{SUITE_BASE_URL}}/test/a/{{SUITE_ALIAS}}/trust-anchor": {{PUBLIC_JWKS:suite-trust-anchor}}}
# The suite runs on this machine, reached from the container as host.docker.internal - a private address the
# outbound URL policy refuses unless the host is named.
OIDF_FETCH_HOST_ALLOWLIST=host.docker.internal
# The suite's certificate comes from keys/suite-tls-ca.crt, which the JDK in the image does not know. PF's own
# fetches - the RP's jwks_uri, when it checks a request object - trust it through the CA this profile imports;
# this module's fetches of the suite's entity statements are told not to check.
OIDF_FEDERATION_IGNORE_SSL_ERRORS=true
# The suite's anchor publishes no metadata_policy, so nothing constrains its RP's metadata. A deployment
# refuses such a chain by default; the rig accepts it, to test registration itself.
OIDF_REQUIRE_METADATA_POLICY=false
# The suite's RP sends no PKCE (its request objects carry client_id, scope, response_type, redirect_uri, iss,
# aud, jti and exp), and PF holds an RP it registers here to PKCE by default.
OIDF_AUTO_REGISTRATION_REQUIRE_PKCE=false
